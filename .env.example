APP_NAME=Laravel
# APP_ENV: Set to 'production' in production, 'local' for development
APP_ENV=local
APP_KEY=
# CRITICAL: APP_DEBUG must be false in production to prevent information disclosure
# Set to true only for local development
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# CRITICAL: Always encrypt session data to protect sensitive information
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Prevent JavaScript access to session cookies (XSS protection)
SESSION_HTTP_ONLY=true
# lax = Allows cookies on same-site requests and top-level navigation (REQUIRED for SPA on different port/subdomain)
# strict = Only exact same-site (would block API calls from frontend on different port)
# Use 'lax' for SPAs with separate frontend/backend. Use 'strict' only for monolithic apps on same origin.
SESSION_SAME_SITE=lax
# CRITICAL: Set to true in production with HTTPS enabled
# Keep false for local development over HTTP
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CORS: Comma-separated list of allowed frontend origins (no spaces)
# Example: http://localhost:3000,https://easybake.app,https://www.easybake.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Sanctum: Stateful domains for SPA session-based authentication
# Include all frontend domains/ports that will make authenticated requests
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:3001,127.0.0.1,127.0.0.1:8000

# Sanctum: API token expiration in minutes (default: 240 = 4 hours)
# Recommended: 240 for web, 1440 for mobile apps
# SANCTUM_TOKEN_EXPIRATION=240
